# Copy to .env and fill in real values. .env is gitignored — never commit it.

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=campusguard
DB_USER=campusguard
DB_PASSWORD=change-me

# --- Authentication ---
# Signs and verifies JWTs. At least 32 bytes; generate with `openssl rand -hex 32`.
# The application refuses to start without it rather than falling back to a default.
JWT_SECRET=

# --- AI moderation ---
# Optional. Leave AI_CHAT_MODEL unset and no model engine is registered at all:
# the queue runs on term matching and everything else works unchanged. A missing
# key is an ordinary configuration here, not an error.
#
# AI_CHAT_MODEL=google-genai
# GEMINI_API_KEY=
#
# Models to register, comma separated. Each is paired with each prompt version,
# giving engines named model/version — so two models and two prompts is four
# engines the benchmark scores side by side.
# GEMINI_MODELS=gemini-3.5-flash-lite
#
# Which of them judges live traffic. Named engine missing? It logs loudly and
# falls back to term matching rather than refusing to start.
# MODERATION_ENGINE=gemini-3.5-flash-lite/v2

# --- Benchmarking ---
# One sample per interval, to stay under the provider's per-minute ceiling.
# 5s paces a run to 12 requests a minute; the free tier allows 15.
# EVAL_CALL_INTERVAL=5s
