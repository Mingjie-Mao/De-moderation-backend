# Copy to .env and fill in real values. .env is gitignored — never commit it.

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=campusguard
DB_USER=campusguard
DB_PASSWORD=change-me

# --- Authentication ---
# Signs and verifies JWTs. At least 32 bytes; generate with `openssl rand -hex 32`.
# The application refuses to start without it rather than falling back to a default.
JWT_SECRET=

# --- First administrator ---
# Registration only ever produces a MEMBER, and every route under /api/admin
# requires ROLE_ADMIN, so a fresh database has a moderation console nobody can
# open. Set both and the account is created at startup.
#
# Read only when that username does not already exist. An existing account is
# never promoted and never has its password rewritten — so naming somebody who
# already registered does not hand them the console, and CHANGING
# ADMIN_PASSWORD BELOW DOES NOT ROTATE AN ALREADY-CREATED ACCOUNT. To change a
# live administrator's password, change it on the account.
#
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=

# --- Exposure ---
# Whether the OpenAPI document and Swagger UI are readable without a credential.
# Leave true for local API exploration. Production reviewers use admin-web, and
# the production profile disables Swagger/OpenAPI rather than publishing a map
# of every route.
# EXPOSE_API_DOCS=true

# Browser origins allowed to call the API, comma separated.
# CORS_ALLOWED_ORIGINS=http://localhost:3000

# Public browser origin used for password-reset links.
# PUBLIC_URL=http://localhost:3000

# --- Media storage ---
# MEDIA_STORAGE_PATH=/var/lib/campusguard/media

# --- Password-reset email (optional in development) ---
# MAIL_ENABLED=false
# MAIL_HOST=smtp.example.edu
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM=no-reply@example.edu
# MAIL_SMTP_AUTH=true
# MAIL_STARTTLS=true

# --- Production reverse proxy and Grafana ---
# DOMAIN=moderation.example.edu
# GRAFANA_ADMIN_PASSWORD=

# --- AI moderation ---
# Optional. Leave AI_CHAT_MODEL unset and no model engine is registered at all:
# the queue runs on term matching and everything else works unchanged. A missing
# key is an ordinary configuration here, not an error.
#
# AI_CHAT_MODEL=google-genai
# GEMINI_API_KEY=
#
# Models to register, comma separated. Each is paired with each prompt version,
# giving engines named model/version — so two models and two prompts is four
# engines the benchmark scores side by side.
# GEMINI_MODELS=gemini-3.5-flash-lite
#
# Which of them judges live traffic. Named engine missing? It logs loudly and
# falls back to term matching rather than refusing to start.
#
# Prompt versions available: v1, v2 (the measured default), and v3. v3 is v2
# with the rationale written in the language of the content, for reviewers
# reading a queue that is not in English; its classification wording is
# identical to v2's, so the benchmark can attribute any difference to that one
# change. Run the evaluation before pointing live traffic at it.
# MODERATION_ENGINE=gemini-3.5-flash-lite/v2

# --- Benchmarking ---
# One sample per interval, to stay under the provider's per-minute ceiling.
# 5s paces a run to 12 requests a minute; the free tier allows 15.
# EVAL_CALL_INTERVAL=5s

# --- Case investigation -------------------------------------------------------
# An assistant a reviewer can ask for the author's record and the precedent under
# a rule, neither of which the case screen can show. Off by default: one click
# calls a model, which is the only place in this system where a click spends
# money directly. See docs/investigation.md.
# INVESTIGATOR_ENABLED=true
#
# How many times one case is investigated before a brief is returned. Above one,
# the evidence band becomes a count of how often the runs agreed rather than the
# model's grade of its own certainty — and costs that many model calls per click.
# INVESTIGATOR_RUNS=1
