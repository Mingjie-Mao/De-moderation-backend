<?xml version="1.0" encoding="utf-8"?>
<!--
  A feed row in the app's own visual language: title, body, author, and the
  separator rhythm the rest of the product uses. Nothing here is decorative for
  its own sake — the point is that a post served by the backend is
  indistinguishable in presentation from one served locally.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingTop="14dp"
    android:paddingEnd="4dp"
    android:paddingBottom="14dp">

    <TextView
        android:id="@+id/textCgPostTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/ink_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textCgPostBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/ink_secondary"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/textCgPostAuthor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/ink_tertiary"
        android:textSize="12sp" />
</LinearLayout>
